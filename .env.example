# =============================================================================
#  Abu Ali — local environment template.
#
#  Copy to `.env` for local runs:      cp .env.example .env
#  In CI (GitHub Actions) these values come from repository secrets instead —
#  see the table in README.md. The agent NEVER writes secrets into code, and
#  every secret value is redacted from the logs before they are written.
#
#  NOTE: `.env` is protected — the agent refuses to read, write or commit it.
# =============================================================================

# ---- intelligence -----------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- persistence (Supabase) -------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: needed only for the Supabase Management API + the Supabase MCP server
SUPABASE_ACCESS_TOKEN=

# ---- source control ---------------------------------------------------------
# Personal Access Token with `repo` + `workflow` scopes.
# GitHub forbids secret names starting with GITHUB_, hence MY_GITHUB_TOKEN.
MY_GITHUB_TOKEN=

# ---- edge (Cloudflare) ------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: the Pages project to deploy when none is named in the request
CLOUDFLARE_PAGES_PROJECT=

# ---- library docs via MCP (optional) ---------------------------------------
CONTEXT7_API_KEY=

# ---- behaviour (optional) ---------------------------------------------------
AGENT_LANGUAGE=ar
AGENT_NAME=Abu Ali
LLM_PROVIDER_ORDER=groq,gemini
AUTO_DEPLOY=true
AUTO_MERGE=false
ABU_DRY_RUN=false
MAX_FILES_PER_PR=10
MAX_ISSUES_PER_RUN=2
MAX_TOOL_TURNS=14
# Allow the agent to write inside .github/workflows/** (default false — unsafe)
ABU_ALLOW_PROTECTED_WRITES=false

# ---- MCP servers (optional JSON override) ----------------------------------
# MCP_ENABLE_GITHUB=false
# MCP_ENABLE_SUPABASE=false
# MCP_ENABLE_CONTEXT7=true
# MCP_SERVERS={"context7":{"url":"https://mcp.context7.com/mcp","transport":"http","apiKeyEnv":"CONTEXT7_API_KEY","enabled":true}}

# ---- local-only niceties ----------------------------------------------------
ABU_LOG_FILE=abu_ali_run.log
ABU_OUTBOX_PATH=.abu-ali/outbox.jsonl
ABU_DEBUG=false
SCHEDULE_DISABLED=false
